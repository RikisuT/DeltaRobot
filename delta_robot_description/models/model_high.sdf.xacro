<?xml version='1.0' encoding='utf-8'?>
<sdf xmlns:xacro="http://www.ros.org/wiki/xacro" version="1.7">
    <!-- PROPERTIES-->
    <!-- Mesh package base-path. -->
    <xacro:property name="meshes" value="package://delta_robot_description/meshes"/>
    <!-- MATERIAL MACROS -->
    <xacro:macro name="material_aluminium">
        <material>
            <ambient>0.2  0.2  0.2  1</ambient>
            <diffuse>0.3  0.3  0.3  1</diffuse>
            <specular>0.95 0.95 0.95 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_anodised_aluminium">
        <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_black_aluminium">
        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1  0.1  0.1  1</diffuse>
            <specular>0.8  0.8  0.8  1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_white_pla">
        <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_grey_pla">
        <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.4  0.4  0.4  1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_black_pla">
        <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.1  0.1  0.1  1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_black_abs">
        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1  0.1  0.1  1</diffuse>
            <specular>0.3  0.3  0.3  1</specular>
        </material>
    </xacro:macro>
    <xacro:macro name="material_carbon_fiber">
        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
            <specular>1.0  1.0  1.0  1</specular>
        </material>
    </xacro:macro>
    <!-- INERTIA MACROS -->
    <!-- Servo mount (×3) -->
    <xacro:macro name="inertial_servo_mount">
        <inertial>
            <mass>0.0241270257</mass>
            <pose>0.000332283 -1.10259e-05 -0.00742638 0 0 0</pose>
            <inertia>
                <ixx>3.7563e-06</ixx>
                <ixy>-4.7e-09</ixy>
                <ixz>3.691e-07</ixz>
                <iyy>6.6333e-06</iyy>
                <iyz>-5.1e-09</iyz>
                <izz>6.1105e-06</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Servo body (×3) -->
    <xacro:macro name="inertial_servo">
        <inertial>
            <mass>0.2665419134</mass>
            <pose>-0.0292907 0.0100195 0.013 0 0 0</pose>
            <inertia>
                <ixx>3.47326e-05</ixx>
                <ixy>-2.3e-07</ixy>
                <ixz>0</ixz>
                <iyy>5.71427e-05</iyy>
                <iyz>0</iyz>
                <izz>6.56729e-05</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Servo horn / free-horn (×6) -->
    <xacro:macro name="inertial_servo_horn">
        <inertial>
            <mass>0.0063187985</mass>
            <pose>-2.7011e-06 0.00300658 2.7463e-06 0 0 0</pose>
            <inertia>
                <ixx>1.378e-07</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>2.59e-07</iyy>
                <iyz>0</iyz>
                <izz>1.378e-07</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Bicep (×3) -->
    <xacro:macro name="inertial_bicep">
        <inertial>
            <mass>0.0299135472</mass>
            <pose>0.0192 0.034737 -0.000404853 0 0 0</pose>
            <inertia>
                <ixx>3.23451e-05</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>5.9246e-06</iyy>
                <iyz>-2.856e-07</iyz>
                <izz>3.55198e-05</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Upper pivot arm — pivot_arm_1 / 2 / 3 -->
    <xacro:macro name="inertial_pivot_arm_upper">
        <inertial>
            <mass>0.0390860375</mass>
            <pose>0 0 -0.00562255 0 0 0</pose>
            <inertia>
                <ixx>1.09743e-05</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>1.2263e-05</iyy>
                <iyz>0</iyz>
                <izz>1.9206e-06</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Upper rod-cap — rod_cap_1 … rod_cap_6 -->
    <xacro:macro name="inertial_rod_cap_upper">
        <inertial>
            <mass>0.0225389015</mass>
            <pose>3.6e-08 -0.0043487373 -0.0088260621 0 0 0</pose>
            <inertia>
                <ixx>1.3755e-06</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>9.166e-07</iyy>
                <iyz>-4.64e-08</iyz>
                <izz>9.897e-07</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Forearm (×6) -->
    <xacro:macro name="inertial_forearm">
        <inertial>
            <mass>0.0405706145</mass>
            <pose>0 0 -0.0950335 0 0 0</pose>
            <inertia>
                <ixx>0.0001222238</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.0001222238</iyy>
                <iyz>0</iyz>
                <izz>1.756e-07</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Lower rod-cap — rod_cap_7 … rod_cap_12 -->
    <xacro:macro name="inertial_rod_cap_lower">
        <inertial>
            <mass>0.022829726</mass>
            <pose>0.000473902 -0.0006512435 3.6e-08 0 0 0</pose>
            <inertia>
                <ixx>1.0025e-06</ixx>
                <ixy>4.7e-08</ixy>
                <ixz>0</ixz>
                <iyy>9.284e-07</iyy>
                <iyz>0</iyz>
                <izz>1.3932e-06</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Lower pivot arm — pivot_arm_4 / 5 / 6 -->
    <xacro:macro name="inertial_pivot_arm_lower">
        <inertial>
            <mass>0.0390860375</mass>
            <pose>0.0093 0 -0.0256226 0 0 0</pose>
            <inertia>
                <ixx>1.09743e-05</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>1.2263e-05</iyy>
                <iyz>0</iyz>
                <izz>1.9206e-06</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- Bevel pinion (×2) -->
    <xacro:macro name="inertial_bevel_pinion">
        <inertial>
            <mass>0.0190930454</mass>
            <pose>-2.927e-07 0.00660778 2.94e-07 0 0 0</pose>
            <inertia>
                <ixx>6.426e-07</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>7.99e-07</iyy>
                <iyz>0</iyz>
                <izz>6.426e-07</izz>
            </inertia>
        </inertial>
    </xacro:macro>
    <!-- UTILITY MACROS -->
    <!-- mesh_geometry -->
    <xacro:macro name="mesh_geometry" params="file">
        <geometry>
            <mesh>
                <uri>${meshes}/${file}</uri>
                <scale>0.001 0.001 0.001</scale>
            </mesh>
        </geometry>
    </xacro:macro>
    <!-- fixed_joint — type="fixed" with no pose element.    -->
    <xacro:macro name="fixed_joint" params="name parent child">
        <joint name="${name}" type="fixed">
            <parent>${parent}</parent>
            <child>${child}</child>
        </joint>
    </xacro:macro>
    <!-- revolute_joint — type="revolute" -->
    <xacro:macro name="revolute_joint" params="name parent child ax ay az">
        <joint name="${name}" type="revolute">
            <parent>${parent}</parent>
            <child>${child}</child>
            <axis>
                <xyz>${ax} ${ay} ${az}</xyz>
            </axis>
        </joint>
    </xacro:macro>
    <!-- LINK MACROS -->
    <!-- servo_mount_link -->
    <xacro:macro name="servo_mount_link" params="n px py pz roll pitch yaw">
        <link name="servo_mount_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="delta_base-v1">${px} ${py} ${pz} ${roll} ${pitch} ${yaw}</pose>
            <xacro:inertial_servo_mount/>
            <visual name="servo_mount_${n}_visual">
                <xacro:mesh_geometry file="servo_mount.stl"/>
                <xacro:material_black_aluminium/>
            </visual>
        </link>
    </xacro:macro>
    <!-- servo_link -->
    <xacro:macro name="servo_link" params="n">
        <link name="servo_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="servo_mount_${n}">0 0.0 -0.0213 ${pi/2} ${pi/2} 0</pose>
            <xacro:inertial_servo/>
            <visual name="servo_${n}">
                <xacro:mesh_geometry file="servo.stl"/>
                <xacro:material_black_abs/>
            </visual>
        </link>
    </xacro:macro>
    <!-- servo_horn_link -->
    <xacro:macro name="servo_horn_link" params="n">
        <link name="servo_${n}_horn">
            <self_collide>false</self_collide>
            <pose relative_to="servo_${n}">0 0 0 0 0 0</pose>
            <xacro:inertial_servo_horn/>
            <visual name="servo_${n}_horn_visual">
                <pose>-0.0125 0 0 0 0 0</pose>
                <xacro:mesh_geometry file="servo_horn.stl"/>
                <xacro:material_anodised_aluminium/>
            </visual>
        </link>
    </xacro:macro>
    <!-- servo_free_horn_link -->
    <xacro:macro name="servo_free_horn_link" params="n">
        <link name="servo_${n}_free_horn">
            <self_collide>false</self_collide>
            <pose relative_to="servo_${n}">0 0 0 0 0 0</pose>
            <xacro:inertial_servo_horn/>
            <visual name="servo_${n}_free_horn_visual">
                <pose>-0.0125 0 0 0 0 0</pose>
                <xacro:mesh_geometry file="servo_free_horn.stl"/>
                <xacro:material_anodised_aluminium/>
            </visual>
        </link>
    </xacro:macro>
    <!-- bicep_link -->
    <xacro:macro name="bicep_link" params="n">
        <link name="bicep${n}">
            <self_collide>false</self_collide>
            <pose relative_to="servo_${n}_horn">0 0 0 0 0 ${-pi/2}</pose>
            <xacro:inertial_bicep/>
            <visual name="bicep${n}_visual">
                <xacro:mesh_geometry file="bicep.stl"/>
                <xacro:material_white_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- pivot_arm_upper_link -->
    <xacro:macro name="pivot_arm_upper_link" params="n px py pz roll pitch yaw">
        <link name="pivot_arm_${n}">
            <self_collide>false</self_collide>
            <pose>${px} ${py} ${pz} ${roll} ${pitch} ${yaw}</pose>
            <xacro:inertial_pivot_arm_upper/>
            <visual name="pivot_arm_${n}_visual">
                <xacro:mesh_geometry file="pivot_arm.stl"/>
                <xacro:material_grey_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- rod_cap_upper_link -->
    <xacro:macro name="rod_cap_upper_link" params="n relative_to z_offset">
        <link name="rod_cap_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0 0 ${z_offset} 0 0 0</pose>
            <xacro:inertial_rod_cap_upper/>
            <visual name="rod_cap_${n}_visual">
                <pose>0 0.005 0 0 0 0</pose>
                <xacro:mesh_geometry file="rod_cap_2.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- forearm_link -->
    <xacro:macro name="forearm_link" params="n relative_to">
        <link name="forearm_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0 0.195 0 ${pi/2} ${pi} 0</pose>
            <xacro:inertial_forearm/>
            <visual name="forearm_${n}_visual">
                <xacro:mesh_geometry file="forearm.stl"/>
                <xacro:material_carbon_fiber/>
            </visual>
        </link>
    </xacro:macro>
    <!-- rod_cap_lower_link -->
    <xacro:macro name="rod_cap_lower_link" params="n relative_to roll">
        <link name="rod_cap_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0 0 0 ${roll} ${pi} 0</pose>
            <xacro:inertial_rod_cap_lower/>
            <visual name="rod_cap_${n}_visual">
                <xacro:mesh_geometry file="rod_cap_2.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- pivot_arm_lower_link -->
    <xacro:macro name="pivot_arm_lower_link" params="n relative_to">
        <link name="pivot_arm_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0 -0.005 0 0 0 0</pose>
            <xacro:inertial_pivot_arm_lower/>
            <visual name="pivot_arm_${n}_visual">
                <pose>0 0 -0.016 0 0 0</pose>
                <xacro:mesh_geometry file="pivot_arm.stl"/>
                <xacro:material_grey_pla/>
            </visual>
        </link>
    </xacro:macro>
    <!-- virtual_pivot_link -->
    <xacro:macro name="virtual_pivot_link" params="n relative_to">
        <link name="virtual_pivot_${n}">
            <self_collide>false</self_collide>
            <pose relative_to="${relative_to}">0 0 0 0 0 0</pose>
        </link>
    </xacro:macro>
    <!-- motor_joint_set -->
    <xacro:macro name="motor_joint_set" params="n">
        <joint name="motor_joint_${n}" type="revolute">
            <parent>servo_${n}</parent>
            <child>servo_${n}_horn</child>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>
        <joint name="motor_joint_${n}_free" type="revolute">
            <parent>servo_${n}</parent>
            <child>servo_${n}_free_horn</child>
            <axis>
                <xyz>0 1 0</xyz>
                <mimic joint="motor_joint_${n}">
                    <multiplier>1</multiplier>
                    <offset>0</offset>
                </mimic>
            </axis>
        </joint>
    </xacro:macro>
    <!-- MODEL -->
    <model name="delta_robot">
        <!-- World anchor -->
        <link name="world_link">
            <self_collide>false</self_collide>
            <inertial>
                <mass>0.01</mass>
                <inertia>
                    <ixx>1e-05</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1e-05</iyy>
                    <iyz>0</iyz>
                    <izz>1e-05</izz>
                </inertia>
            </inertial>
        </link>
        <!-- Structural frame -->
        <link name="frame">
            <self_collide>false</self_collide>
            <static>true</static>
            <pose>0 0 -0.059454 0 0 0</pose>
            <inertial>
                <pose>0 0 0 0 0 0</pose>
                <mass>700.084375</mass>
                <inertia>
                    <ixx>4.0277965312</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.0964840312</iyy>
                    <iyz>0</iyz>
                    <izz>4.6133059896</izz>
                </inertia>
            </inertial>
            <collision name="Frame_collision">
                <xacro:mesh_geometry file="frame.stl"/>
            </collision>
            <visual name="Frame_visual">
                <xacro:mesh_geometry file="frame.stl"/>
                <xacro:material_black_aluminium/>
            </visual>
        </link>
        <!-- Delta base plate -->
        <link name="delta_base-v1">
            <self_collide>false</self_collide>
            <pose>0 0 -0.01 0 0 0</pose>
            <inertial>
                <mass>0.3507402885</mass>
                <pose>0 0 0.01 0 0 0</pose>
                <inertia>
                    <ixx>0.0001943686</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.0001943686</iyy>
                    <iyz>0</iyz>
                    <izz>0.0003653545</izz>
                </inertia>
            </inertial>
            <visual name="delta_base-v1_visual">
                <xacro:mesh_geometry file="delta_base-v1.stl"/>
                <xacro:material_aluminium/>
            </visual>
        </link>
        <!-- Arm 1 -->
        <xacro:servo_mount_link n="1"
            px=" 0.0787"  py="0"       pz="0.01"
            roll="${-pi/2}" pitch="0"  yaw="${pi/2}"/>
        <xacro:servo_link           n="1"/>
        <xacro:servo_horn_link      n="1"/>
        <xacro:servo_free_horn_link n="1"/>
        <xacro:bicep_link           n="1"/>
        <!-- Arm 2 -->
        <xacro:servo_mount_link n="2"
            px="-0.03935"  py=" 0.06816"  pz="0.01"
            roll="${-pi/2}" pitch="0"     yaw="${-5*pi/6}"/>
        <xacro:servo_link           n="2"/>
        <xacro:servo_horn_link      n="2"/>
        <xacro:servo_free_horn_link n="2"/>
        <xacro:bicep_link           n="2"/>
        <!-- Arm 3 -->
        <xacro:servo_mount_link n="3"
            px="-0.03935"  py="-0.06816"  pz="0.01"
            roll="${-pi/2}" pitch="0"     yaw="${-pi/6}"/>
        <xacro:servo_link           n="3"/>
        <xacro:servo_horn_link      n="3"/>
        <xacro:servo_free_horn_link n="3"/>
        <xacro:bicep_link           n="3"/>
        <!-- Upper pivot arms -->
        <xacro:pivot_arm_upper_link n="1"
            px=" 0.2"     py=" 0.0103"   pz="0"
            roll="${-pi/2}" pitch="0.9926555" yaw="0"/>
        <xacro:pivot_arm_upper_link n="2"
            px="-0.10892" py=" 0.16806"  pz="0"
            roll="${-pi/2}" pitch="0.9926555" yaw="${2*pi/3}"/>
        <xacro:pivot_arm_upper_link n="3"
            px="-0.09108" py="-0.17836"  pz="0"
            roll="${-pi/2}" pitch="0.9926555" yaw="${-2*pi/3}"/>
        <!-- Upper rod-caps -->
        <xacro:rod_cap_upper_link n="1" relative_to="pivot_arm_1" z_offset="-0.036"/>
        <xacro:rod_cap_upper_link n="2" relative_to="pivot_arm_1" z_offset=" 0.016"/>
        <xacro:rod_cap_upper_link n="3" relative_to="pivot_arm_2" z_offset="-0.036"/>
        <xacro:rod_cap_upper_link n="4" relative_to="pivot_arm_2" z_offset=" 0.016"/>
        <xacro:rod_cap_upper_link n="5" relative_to="pivot_arm_3" z_offset="-0.036"/>
        <xacro:rod_cap_upper_link n="6" relative_to="pivot_arm_3" z_offset=" 0.016"/>
        <!-- Forearms -->
        <xacro:forearm_link n="1" relative_to="rod_cap_1"/>
        <xacro:forearm_link n="2" relative_to="rod_cap_2"/>
        <xacro:forearm_link n="3" relative_to="rod_cap_3"/>
        <xacro:forearm_link n="4" relative_to="rod_cap_4"/>
        <xacro:forearm_link n="5" relative_to="rod_cap_5"/>
        <xacro:forearm_link n="6" relative_to="rod_cap_6"/>
        <!-- Lower rod-caps -->
        <xacro:rod_cap_lower_link n="7"  relative_to="forearm_1" roll="${-pi/2}"/>
        <xacro:rod_cap_lower_link n="8"  relative_to="forearm_2" roll="${-pi/2}"/>
        <xacro:rod_cap_lower_link n="9"  relative_to="forearm_3" roll="${-pi/2}"/>
        <xacro:rod_cap_lower_link n="10" relative_to="forearm_4" roll="${-pi/2}"/>
        <xacro:rod_cap_lower_link n="11" relative_to="forearm_5" roll="${-pi/2}"/>
        <xacro:rod_cap_lower_link n="12" relative_to="forearm_6" roll="${-pi/2}"/>
        <!-- Detachable-joint auxiliary links -->
        <link name="rod_cap_8_1">
            <self_collide>false</self_collide>
            <pose relative_to="rod_cap_8">0.0093 -0.005 0 0 0 0</pose>
        </link>
        <link name="rod_cap_10_1">
            <self_collide>false</self_collide>
            <pose relative_to="rod_cap_10">0.0093 -0.005 0 0 0 0</pose>
        </link>
        <link name="rod_cap_12_1">
            <self_collide>false</self_collide>
            <pose relative_to="rod_cap_12">0.0093 -0.005 0 0 0 0</pose>
        </link>
        <!-- Lower pivot arms -->
        <xacro:pivot_arm_lower_link n="4" relative_to="rod_cap_7"/>
        <xacro:pivot_arm_lower_link n="5" relative_to="rod_cap_9"/>
        <xacro:pivot_arm_lower_link n="6" relative_to="rod_cap_11"/>
        <!-- End-effector -->
        <link name="end_effector">
            <self_collide>false</self_collide>
            <pose>0 0 -0.10928515 ${-pi/2} 0 ${-pi/2}</pose>
            <inertial>
                <mass>0.3630684398</mass>
                <pose>0 0 0 0 0 0</pose>
                <inertia>
                    <ixx>9.77541e-05</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.0001606476</iyy>
                    <iyz>0</iyz>
                    <izz>9.77541e-05</izz>
                </inertia>
            </inertial>
            <visual name="end_effector_visual">
                <xacro:mesh_geometry file="end_effector.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
        <!-- Differential mechanism ─differential_c_arm -->
        <link name="differential_c_arm">
            <self_collide>false</self_collide>
            <pose>0.03239 0.0075 -0.17691 ${pi} 0 ${-pi/2}</pose>
            <inertial>
                <mass>0.0546277939</mass>
                <pose>0 4.999e-07 0.00560002 0 0 0</pose>
                <inertia>
                    <ixx>2.97964e-05</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>2.7248e-06</iyy>
                    <iyz>0</iyz>
                    <izz>2.91283e-05</izz>
                </inertia>
            </inertial>
            <visual name="differential_c_arm_visual">
                <xacro:mesh_geometry file="differential_c_arm.stl"/>
                <xacro:material_grey_pla/>
            </visual>
        </link>
        <link name="bevel_pinion_1">
            <self_collide>false</self_collide>
            <pose>0.01939 0 -0.13691 ${pi} 0 ${-pi/2}</pose>
            <xacro:inertial_bevel_pinion/>
            <visual name="bevel_pinion_1_visual">
                <xacro:mesh_geometry file="bevel_pinion.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
        <link name="bevel_pinion_2">
            <self_collide>false</self_collide>
            <pose>-0.01939 0 -0.13691 ${-pi/2} ${-pi/2} 0</pose>
            <xacro:inertial_bevel_pinion/>
            <visual name="bevel_pinion_2_visual">
                <xacro:mesh_geometry file="bevel_pinion.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
        <link name="differentialT">
            <self_collide>false</self_collide>
            <pose>0.0273875 0 -0.13691 ${pi} 0 0</pose>
            <inertial>
                <mass>0.0162534729</mass>
                <pose>-0.0273872 1.64327e-05 0.00296495 0 0 0</pose>
                <inertia>
                    <ixx>6.051e-07</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>3.6171e-06</iyy>
                    <iyz>-2.2e-09</iyz>
                    <izz>3.0857e-06</izz>
                </inertia>
            </inertial>
            <visual name="differentialT_visual">
                <pose>-0.054775 -0.06 0 0 0 0</pose>
                <xacro:mesh_geometry file="differentialT.stl"/>
                <xacro:material_grey_pla/>
            </visual>
        </link>
        <link name="bevel_gear_ee">
            <self_collide>false</self_collide>
            <pose>0 -0.00006 -0.14741 ${pi/2} 0 0.0829</pose>
            <inertial>
                <mass>0.0619505392</mass>
                <pose>0.000111662 0.00634985 0 0 0 0</pose>
                <inertia>
                    <ixx>5.595e-06</ixx>
                    <ixy>2.66e-08</ixy>
                    <ixz>0</ixz>
                    <iyy>9.2871e-06</iyy>
                    <iyz>0</iyz>
                    <izz>5.5334e-06</izz>
                </inertia>
            </inertial>
            <visual name="bevel_gear_ee_visual">
                <xacro:mesh_geometry file="bevel_gear_ee.stl"/>
                <xacro:material_black_pla/>
            </visual>
        </link>
        <!-- Virtual pivot constraints ─-->
        <xacro:virtual_pivot_link n="1" relative_to="pivot_arm_4"/>
        <xacro:virtual_pivot_link n="2" relative_to="pivot_arm_5"/>
        <xacro:virtual_pivot_link n="3" relative_to="pivot_arm_6"/>
        <!-- JOINTS -->
        <!-- Frame chain -->
        <xacro:fixed_joint name="joint_world_to_frame" parent="world_link"    child="frame"/>
        <xacro:fixed_joint name="joint_frame_to_base"  parent="frame"         child="delta_base-v1"/>
        <!-- Servo mounts → base plate -->
        <xacro:fixed_joint name="delta_base_to_servo_mount_1" parent="delta_base-v1" child="servo_mount_1"/>
        <xacro:fixed_joint name="delta_base_to_servo_mount_2" parent="delta_base-v1" child="servo_mount_2"/>
        <xacro:fixed_joint name="delta_base_to_servo_mount_3" parent="delta_base-v1" child="servo_mount_3"/>
        <!-- Servo bodies → servo mounts -->
        <xacro:fixed_joint name="servo_mount_1_to_servo_1" parent="servo_mount_1" child="servo_1"/>
        <xacro:fixed_joint name="servo_mount_2_to_servo_2" parent="servo_mount_2" child="servo_2"/>
        <xacro:fixed_joint name="servo_mount_3_to_servo_3" parent="servo_mount_3" child="servo_3"/>
        <!-- Motor joints — driven revolute + mimic free-horn, one set per arm -->
        <xacro:motor_joint_set n="1"/>
        <xacro:motor_joint_set n="2"/>
        <xacro:motor_joint_set n="3"/>
        <!-- Horns → biceps (rigid) -->
        <xacro:fixed_joint name="servo_1_horn_to_bicep1" parent="servo_1_horn" child="bicep1"/>
        <xacro:fixed_joint name="servo_2_horn_to_bicep2" parent="servo_2_horn" child="bicep2"/>
        <xacro:fixed_joint name="servo_3_horn_to_bicep3" parent="servo_3_horn" child="bicep3"/>
        <!-- Biceps → upper pivot arms (passive revolute, axis Z) -->
        <xacro:revolute_joint name="bicep_1_to_pivot_arm_1" parent="bicep1" child="pivot_arm_1" ax="0" ay="0" az="1"/>
        <xacro:revolute_joint name="bicep_2_to_pivot_arm_2" parent="bicep2" child="pivot_arm_2" ax="0" ay="0" az="1"/>
        <xacro:revolute_joint name="bicep_3_to_pivot_arm_3" parent="bicep3" child="pivot_arm_3" ax="0" ay="0" az="1"/>
        <!-- Upper pivot arms → upper rod-caps (passive revolute, axis X) -->
        <xacro:revolute_joint name="pivot_arm_1_to_rod_cap_1" parent="pivot_arm_1" child="rod_cap_1" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="pivot_arm_1_to_rod_cap_2" parent="pivot_arm_1" child="rod_cap_2" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="pivot_arm_2_to_rod_cap_3" parent="pivot_arm_2" child="rod_cap_3" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="pivot_arm_2_to_rod_cap_4" parent="pivot_arm_2" child="rod_cap_4" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="pivot_arm_3_to_rod_cap_5" parent="pivot_arm_3" child="rod_cap_5" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="pivot_arm_3_to_rod_cap_6" parent="pivot_arm_3" child="rod_cap_6" ax="1" ay="0" az="0"/>
        <!-- Upper rod-caps → forearms (rigid) -->
        <xacro:fixed_joint name="rod_cap_1_Rigid-17" parent="rod_cap_1" child="forearm_1"/>
        <xacro:fixed_joint name="rod_cap_2_Rigid-16" parent="rod_cap_2" child="forearm_2"/>
        <xacro:fixed_joint name="rod_cap_3_Rigid-21" parent="rod_cap_3" child="forearm_3"/>
        <xacro:fixed_joint name="rod_cap_4_Rigid-20" parent="rod_cap_4" child="forearm_4"/>
        <xacro:fixed_joint name="rod_cap_5_Rigid-19" parent="rod_cap_5" child="forearm_5"/>
        <xacro:fixed_joint name="rod_cap_6_Rigid-18" parent="rod_cap_6" child="forearm_6"/>
        <!-- Forearms → lower rod-caps (rigid) -->
        <xacro:fixed_joint name="forearm_1_Rigid-42" parent="forearm_1" child="rod_cap_7"/>
        <xacro:fixed_joint name="forearm_2_Rigid-43" parent="forearm_2" child="rod_cap_8"/>
        <xacro:fixed_joint name="forearm_3_Rigid-44" parent="forearm_3" child="rod_cap_9"/>
        <xacro:fixed_joint name="forearm_4_Rigid-45" parent="forearm_4" child="rod_cap_10"/>
        <xacro:fixed_joint name="forearm_5_Rigid-46" parent="forearm_5" child="rod_cap_11"/>
        <xacro:fixed_joint name="forearm_6_Rigid-47" parent="forearm_6" child="rod_cap_12"/>
        <!-- Lower rod-caps → lower pivot arms -->
        <xacro:revolute_joint name="rod_cap_7_to_pivot_arm_4"  parent="rod_cap_7"  child="pivot_arm_4"  ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="rod_cap_8_to_pivot_arm_4"  parent="rod_cap_8"  child="rod_cap_8_1"  ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="rod_cap_9_to_pivot_arm_5"  parent="rod_cap_9"  child="pivot_arm_5"  ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="rod_cap_10_to_pivot_arm_5" parent="rod_cap_10" child="rod_cap_10_1" ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="rod_cap_11_to_pivot_arm_6" parent="rod_cap_11" child="pivot_arm_6"  ax="1" ay="0" az="0"/>
        <xacro:revolute_joint name="rod_cap_12_to_pivot_arm_6" parent="rod_cap_12" child="rod_cap_12_1" ax="1" ay="0" az="0"/>
        <!-- DetachableJoint plugins -->
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>rod_cap_8_1</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>pivot_arm_4</child_link>
        </plugin>
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>rod_cap_10_1</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>pivot_arm_5</child_link>
        </plugin>
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>rod_cap_12_1</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>pivot_arm_6</child_link>
        </plugin>
        <!-- Virtual pivot joints (passive revolute, axis Z) -->
        <xacro:revolute_joint name="pivot_joint_4_to_virtual_pivot_1" parent="pivot_arm_4" child="virtual_pivot_1" ax="0" ay="0" az="1"/>
        <xacro:revolute_joint name="pivot_joint_5_to_virtual_pivot_2" parent="pivot_arm_5" child="virtual_pivot_2" ax="0" ay="0" az="1"/>
        <xacro:revolute_joint name="pivot_joint_6_to_virtual_pivot_3" parent="pivot_arm_6" child="virtual_pivot_3" ax="0" ay="0" az="1"/>
        <!-- Virtual pivots → end-effector -->
        <xacro:fixed_joint name="virtual_pivot_1_to_end_effector" parent="virtual_pivot_1" child="end_effector"/>
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>virtual_pivot_2</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>end_effector</child_link>
        </plugin>
        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>virtual_pivot_3</parent_link>
            <child_model>delta_robot</child_model>
            <child_link>end_effector</child_link>
        </plugin>
        <!-- Differential mechanism joints -->
        <xacro:fixed_joint    name="end_effector_to_differential_c_arm"  parent="end_effector"       child="differential_c_arm"/>
        <xacro:revolute_joint name="differential_T_joint"                 parent="differential_c_arm" child="differentialT"  ax="1" ay=" 0" az="0"/>
        <xacro:revolute_joint name="differential_pinion_joint_1"          parent="differential_c_arm" child="bevel_pinion_1" ax="0" ay=" 1" az="0"/>
        <xacro:revolute_joint name="differential_pinion_joint_2"          parent="differential_c_arm" child="bevel_pinion_2" ax="0" ay=" 1" az="0"/>
        <xacro:revolute_joint name="differential_EE_joint"                parent="differentialT"      child="bevel_gear_ee"  ax="0" ay="-1" az="0"/>
        <!-- ROS 2 CONTROL -->
        <ros2_control name="GazeboSimSystem" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
            <!-- Motor joints — order preserved from original -->
            <joint name="motor_joint_2">
                <command_interface name="position"/>
                <state_interface   name="position"/>
                <state_interface   name="velocity"/>
            </joint>
            <joint name="motor_joint_1">
                <command_interface name="position"/>
                <state_interface   name="position"/>
                <state_interface   name="velocity"/>
            </joint>
            <joint name="motor_joint_3">
                <command_interface name="position"/>
                <state_interface   name="position"/>
                <state_interface   name="velocity"/>
            </joint>
            <!-- Differential joints -->
            <joint name="differential_pinion_joint_1">
                <command_interface name="position"/>
                <state_interface   name="position"/>
                <state_interface   name="velocity"/>
            </joint>
            <joint name="differential_pinion_joint_2">
                <command_interface name="position"/>
                <state_interface   name="position"/>
                <state_interface   name="velocity"/>
            </joint>
            <joint name="differential_T_joint">
                <command_interface name="position"/>
                <state_interface   name="position"/>
                <state_interface   name="velocity"/>
            </joint>
            <joint name="differential_EE_joint">
                <command_interface name="position"/>
                <state_interface   name="position"/>
                <state_interface   name="velocity"/>
            </joint>
        </ros2_control>
        <!-- PLUGINS -->
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find delta_robot_sim)/config/ros2_controllers.yaml</parameters>
        </plugin>
        <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <static_publisher>false</static_publisher>
            <static_update_frequency>100</static_update_frequency>
        </plugin>
    </model>
</sdf>